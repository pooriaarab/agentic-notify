{
  // Live demo Worker. Deploy with: npm run deploy:demo
  // The D1 id is not a secret. The database lives in the EU (created with --location weur).
  "name": "agentic-notify-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "vars": {
    "NOTIFY_NAME": "agentic-notify-demo",
    "NOTIFY_REGION": "eu",
    "NOTIFY_RETENTION_DAYS": "7"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "agentic-notify-demo", "database_id": "d325af69-7edd-44eb-98cf-aea0defc5d1e" }
  ],
  "triggers": { "crons": ["17 3 * * *"] }
}
