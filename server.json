{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pooriaarab/agentic-notify",
  "description": "Notifications for humans and agents: in-app inbox, webhook and email delivery.",
  "version": "0.6.0",
  "repository": {
    "url": "https://github.com/pooriaarab/agentic-notify",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "agentic-notify",
      "version": "0.6.0",
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "packageArguments": [
        { "type": "positional", "valueHint": "subcommand", "value": "mcp" }
      ]
    }
  ]
}
