{
  "name": "agentic-notify",
  "version": "0.6.3",
  "description": "Notifications for humans and agents: in-app inbox, webhook and email delivery, with SDK, CLI, MCP server and Worker API.",
  "keywords": [
    "notifications",
    "inbox",
    "webhook",
    "agents",
    "mcp",
    "cli",
    "cloudflare-workers",
    "typescript"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-notify.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-notify",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./ui.css": "./dist/ui.css"
  },
  "bin": {
    "agentic-notify": "./dist/cli.js",
    "agentic-notify-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "ci:local": "npm run build && npm run typecheck && npm run check:worker && npm test && npm run test:ui",
    "deploy:demo": "npm run build:ui && WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.demo.jsonc",
    "check:worker": "esbuild src/worker.ts --bundle --platform=neutral --format=esm --log-level=warning --outfile=node_modules/.cache/worker-check.js",
    "build:ui": "node scripts/build-ui.mjs",
    "test:ui": "npm run build:ui && playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "agentic-design": ">=0.8.0 <0.11.0",
    "agentic-identity": ">=0.9.0 <0.11.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentic-design": "0.10.0",
    "agentic-identity": "0.10.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
